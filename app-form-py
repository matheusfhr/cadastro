import tkinter as tk
from tkinter import messagebox
from tkinter import ttk
import sqlite3

# Conectar ao banco de dados (ou criar se não existir)
conn = sqlite3.connect('clientes.db')
cursor = conn.cursor()

# Criar tabela se não existir
cursor.execute('''
CREATE TABLE IF NOT EXISTS clientes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nome TEXT NOT NULL,
    email TEXT NOT NULL,
    telefone TEXT NOT NULL
)
''')
conn.commit()

# Função para limpar o formulário
def limpar_formulario():
    entry_nome.delete(0, tk.END)
    entry_email.delete(0, tk.END)
    entry_telefone.delete(0, tk.END)

# Função para salvar os dados do cliente no banco de dados
def salvar_cliente():
    nome = entry_nome.get()
    email = entry_email.get()
    telefone = entry_telefone.get()

    if nome and email and telefone:
        cursor.execute('INSERT INTO clientes (nome, email, telefone) VALUES (?, ?, ?)', (nome, email, telefone))
        conn.commit()
        messagebox.showinfo("Sucesso", "Cliente salvo com sucesso!")
        limpar_formulario()
    else:
        messagebox.showwarning("Atenção", "Todos os campos devem ser preenchidos!")

# Função para visualizar os dados dos clientes
def visualizar_clientes():
    janela_visualizacao = tk.Toplevel(root)
    janela_visualizacao.title("Clientes Cadastrados")

    # Configuração da tabela de exibição
    tree = ttk.Treeview(janela_visualizacao, columns=("ID", "Nome", "Email", "Telefone"), show="headings")
    tree.heading("ID", text="ID")
    tree.heading("Nome", text="Nome")
    tree.heading("Email", text="Email")
    tree.heading("Telefone", text="Telefone")
    
    # Ajuste do tamanho das colunas
    tree.column("ID", width=30, anchor=tk.CENTER)
    tree.column("Nome", width=150)
    tree.column("Email", width=150)
    tree.column("Telefone", width=100, anchor=tk.CENTER)
    tree.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)

    # Buscar dados no banco e popular a tabela
    cursor.execute('SELECT * FROM clientes')
    for row in cursor.fetchall():
        tree.insert("", tk.END, values=row)

# Configuração da Interface Gráfica principal
root = tk.Tk()
root.title("Cadastro de Clientes")

# Rótulos (Labels) e Entradas de dados (Entry)
tk.Label(root, text="Nome:").grid(row=0, column=0, padx=10, pady=5, sticky="e")
entry_nome = tk.Entry(root, width=30)
entry_nome.grid(row=0, column=1, padx=10, pady=5)

tk.Label(root, text="Email:").grid(row=1, column=0, padx=10, pady=5, sticky="e")
entry_email = tk.Entry(root, width=30)
entry_email.grid(row=1, column=1, padx=10, pady=5)

tk.Label(root, text="Telefone:").grid(row=2, column=0, padx=10, pady=5, sticky="e")
entry_telefone = tk.Entry(root, width=30)
entry_telefone.grid(row=2, column=1, padx=10, pady=5)

# Botões do formulário
tk.Button(root, text="Salvar", command=salvar_cliente, width=10).grid(row=3, column=0, pady=10)
tk.Button(root, text="Limpar", command=limpar_formulario, width=10).grid(row=3, column=1, pady=10)
tk.Button(root, text="Visualizar Clientes", command=visualizar_clientes, width=20).grid(row=4, column=0, columnspan=2, pady=5)

# Garante que a conexão seja fechada ao encerrar o aplicativo
def ao_fechar():
    conn.close()
    root.destroy()

root.protocol("WM_DELETE_WINDOW", ao_fechar)

root.mainloop()
